# =====================================================================
#  .gitignore — Sistema de transcripción de informes médicos
#  Regla general: el repositorio contiene SOLO código y documentación.
#  Nada de datos de pacientes, secretos, configuraciones locales ni binarios.
# =====================================================================

# --- Secretos y configuración local -----------------------------------
# contraseñas (PBKDF2), llaves de las PC, canal ntfy
acceso_remoto.json
# transcriptores (huellas PBKDF2 de sus contraseñas) y sesiones abiertas
usuarios.json
sesiones.json
# configuración local (se crea desde configuracion.ejemplo.json)
configuracion.json
*.env
.env*
*.pem
*.key

# --- Datos clínicos y derivados (NUNCA se suben) ----------------------
# plantillas reales, notas de médicos, correcciones aprendidas
conocimiento/
# pares dictado → informe de pacientes reales
ejemplos/
# informes Word reales convertidos a texto
referencias/
# evaluaciones e historial sobre audios reales
resultados/
# logs y actividad.csv (nombres de casos, PC, médicos)
registros/
Informes/
Audios_nuevos/
Dataset/
*.wav
*.mp3
*.m4a
*.ogg
*.flac
*.wma
*.aac
*.opus
*.doc
*.docx
*.dotm

# --- Distribución de la app del trabajo (se genera al compilar) -------
# Solo se versionan el manual y el .config; el .exe, las DLL de WebView2 y
# conexion.json (contiene el canal secreto de avisos) quedan fuera.
cliente/*
!cliente/LEEME.txt
!cliente/Transcripcion.exe.config
cliente_codigo/bin/
cliente_codigo/obj/
cliente_codigo/lib/
*.exe
*.dll
*.pdb
*.viejo*
*.nuevo
*.fallida

# --- Herramientas descargadas -----------------------------------------
cloudflared.exe
# Linux: cloudflared que baja iniciar_servidor.sh
/cloudflared
cloudflared.descarga
# Microsoft Dev Tunnels (lo baja configurar_tunel)
devtunnel.exe
/devtunnel
devtunnel.exe.descarga
devtunnel.descarga

# --- Respaldos y archivos de trabajo ----------------------------------
respaldo/
respaldo_*/
_huellas.json
cola_procesamiento.sqlite3*
_ia_vuelve
*.bak
*.tmp

# --- Python -----------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv-linux/
venv/
.pytest_cache/

# --- Editores y sistema operativo -------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Entorno de pruebas (crear_entorno_pruebas.py)
.entorno_pruebas
/iniciar_pruebas.bat
/iniciar_pruebas.sh

# Archivos de prueba sueltos
*.tgz
pruebas/*.png

# --- Reconocimiento de voz ---------------------------------------------
# huellas de voz de los médicos (datos biométricos: nunca se suben)
voces/
# modelo de voz (se baja solo la primera vez)
modelos/
